#! /bin/bash

# Do not notify more frequently than this
TIMEOUT=5
ICONFILE=~/.cache/packages.icon
LOGFILE=~/.cache/packages.log

LASTNOTIFY=0

function notify() {
    NOW=$(date +%s)
    let diff=$NOW-$LASTNOTIFY

    if [ $diff -lt $TIMEOUT ]
    then
        return
    fi

    if [ $1 -eq 1 ]
    then
        notify-send -t 5000 "Updates Available" "$1 package is out of date"
        LASTNOTIFY=$NOW
    elif [ $1 -gt 1 ]
    then
        notify-send -t 5000 "Updates Available" "$1 packages are out of date"
        LASTNOTIFY=$NOW
    fi
}

function record() {
    > $ICONFILE
    > $LOGFILE

    if [ $1 -gt 299 ]
    then
        echo "󰋙" > $ICONFILE
    elif [ $1 -gt 199 ]
    then
        echo "󰫃" > $ICONFILE
    elif [ $1 -gt 99 ]
    then
        echo "󰫄" > $ICONFILE
    elif [ $1 -gt 49 ]
    then
        echo "󰫅" > $ICONFILE
    elif [ $1 -gt 9 ]
    then
        echo "󰫆" > $ICONFILE
    elif [ $1 -gt 0 ]
    then
        echo "󰫇" > $ICONFILE
    else
        echo "󰫈" > $ICONFILE
    fi

    if [ $1 -eq 1 ]
    then
        echo "$1 outdated package" > $LOGFILE
    elif [ $1 -gt 1 ]
    then
        echo "$1 outdated packages" > $LOGFILE
    else
        echo "System up to date" > $LOGFILE
    fi
}

sudo pacman -Sy &> /dev/null
OUTDATED=$(pacman -Qu | wc -l)

notify $OUTDATED
record $OUTDATED

while [ true ]
do
    inotifywait -e delete /var/lib/pacman/

    OUTDATED=$(pacman -Qu | wc -l)
    notify $OUTDATED
    record $OUTDATED
done
