# =========
#  General
# =========

# Modifier: LGUI
#set $mod Mod4
set $mod Mod1

#font DejaVu Sans Mono Nerd Font 10
font MesloLGS Nerd Font Propo 9

# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# Preferred terminal emulator
set $term foot

# Border width
set $border_width 3

# Switching to active workspace moves to previous one
workspace_auto_back_and_forth yes

# Workspace names
set $ws1  "1"
set $ws2  "2"
set $ws3  "3"
set $ws4  "4"
set $ws5  "5"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"
set $wszn ""
set $wsff ""
set $wssp ""
set $wsst ""
set $wsds "󰙯"
set $wsmg "󰵅"
set $wsob ""
set $wsan ""

# Mouse doesn't affect focus
focus_follows_mouse no
mouse_warping none

# Hide edge borders
smart_borders on
smart_gaps on
gaps inner $border_width

# Start graphical authentication agent
exec /usr/bin/lxqt-policykit-agent

# Start mako (notification daemon) and udiskie (automount usb devices)
exec mako &
exec udiskie -f '' &

# Start monitoring pacman
exec ~/bin/notifyupdates &

# ======================
#  Output configuration
# ======================

