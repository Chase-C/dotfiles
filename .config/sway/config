# =============
#  Colors + UI
# =============

set $background #1a1b26
set $bgstorm    #32344a
set $foreground #a9b1d6
set $red        #f7768e
set $orange     #ff9e64
set $yellow     #e0af68
set $green      #9ece6a
set $cyan1      #73daca
set $cyan2      #2ac3de
set $lightblue  #7dcfff
set $blue       #7aa2f7
set $purple     #bb9af7

#                       BORDER   BACKGROUND  TEXT     INDICATOR CHILD_BORDER
client.focused          $blue    $background $blue    $purple   $blue 
client.focused_inactive $bgstorm $bgstorm    $bgstorm $purple   $bgstorm
client.unfocused        $bgstorm $bgstorm    $bgstorm $purple   $bgstorm
client.urgent           $red     $purple     $red     $red      $red   

# Borders
default_border pixel $border_width
default_floating_border pixel $border_width

# ==============
#  Key bindings
# ==============

# -------
#  Basic
# -------

# Start a terminal
bindsym $mod+Return exec $term

# Kill focused window
bindsym $mod+Shift+q kill

# Start launcher
bindsym $mod+o exec --no-startup-id rofi -show run
bindsym $mod+w exec --no-startup-id rofi -show window
#bindsym $mod+Shift+s exec --no-startup-id rofi -show ssh

# Drag floating windows by holding down $mod and left mouse button.
# Resize them with right mouse button + $mod.
floating_modifier $mod normal

# Reload the configuration file
bindsym $mod+Shift+r reload

# Exit sway (logs you out of your Wayland session)
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -b 'Yes, exit sway' 'swaymsg exit'
bindsym $mod+Shift+Delete exec swaymsg exit

# Dismiss first notification
bindsym $mod+n exec makoctl dismiss

# ---------
#  Fn Keys
# ---------

set $wob_sock $XDG_RUNTIME_DIR/wob.sock

# --- Volume Control (with WOB) ---
# pamixer --get-volume returns a simple number like "55"
bindsym --locked XF86AudioRaiseVolume exec pamixer -i 5 && pamixer --get-volume > $wob_sock
bindsym --locked XF86AudioLowerVolume exec pamixer -d 5 && pamixer --get-volume > $wob_sock
bindsym --locked XF86AudioMute exec pamixer -t && bash -c "pamixer --get-mute | grep -q true && echo 0 > $wob_sock || pamixer --get-volume > $wob_sock"

# --- Brightness Control (with WOB) ---
# brightnessctl -m (machine readable) output is comma-separated: device,class,current,max,percentage%
# We use 'cut' to grab the 4th field (percentage) and 'tr' to remove the '%' sign
# We wrap the command in 'sh -c' and use 'echo' to force a newline at the end.
bindsym --locked XF86MonBrightnessUp exec sh -c "echo \$(brightnessctl set 5%+ -n -m | cut -d, -f4 | tr -d %) > $wob_sock"
bindsym --locked XF86MonBrightnessDown exec sh -c "echo \$(brightnessctl set 5%- -n -m | cut -d, -f4 | tr -d %) > $wob_sock"

# Screenshots with printscreen
bindsym Print exec grim_screenshot

# ----------
#  Movement
# ----------

# Move your focus around
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

# _move_ the focused window with the same, but add Shift
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# ------------
#  Workspaces
# ------------

# switch to workspace
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10
bindsym $mod+f workspace $wsff
bindsym $mod+z workspace $wszn
bindsym $mod+s workspace $wssp
bindsym $mod+g workspace $wsst
bindsym $mod+d workspace $wsds
bindsym $mod+t workspace $wsmg
bindsym $mod+m workspace $wsob
bindsym $mod+a workspace $wsan

# Firefox workspace is always on DP-2
#workspace $wsff output DP-2

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10
bindsym $mod+Shift+f move container to workspace $wsff
bindsym $mod+Shift+z move container to workspace $wszn
bindsym $mod+Shift+s move container to workspace $wssp
bindsym $mod+Shift+g move container to workspace $wsst
bindsym $mod+Shift+d move container to workspace $wsds
bindsym $mod+Shift+t move container to workspace $wsmg
bindsym $mod+Shift+m move container to workspace $wsob
bindsym $mod+Shift+a move container to workspace $wsan

# --------
#  Layout
# --------

# You can "split" the current object of your focus with
# $mod+b or $mod+v, for horizontal and vertical splits
# respectively.
bindsym $mod+b splith
bindsym $mod+v splitv

# Switch the current container between different layout styles
#bindsym $mod+s layout stacking
#bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Make the current focus fullscreen
#bindsym $mod+Shift+f fullscreen

# Toggle the current focus between tiling and floating mode
bindsym $mod+Shift+space floating toggle

# Swap focus between the tiling area and the floating area
bindsym $mod+space focus mode_toggle

# move focus to the parent container
#bindsym $mod+a focus parent

# ------------
#  Scratchpad
# ------------

# Move the currently focused window to the scratchpad
bindsym $mod+Shift+Semicolon border pixel $border_width; move scratchpad

# Show the next scratchpad window or hide the focused scratchpad window.
# If there are multiple scratchpad windows, this command cycles through them.
bindsym $mod+Semicolon scratchpad show

# ---------------------
#  Resizing containers
# ---------------------

bindsym $mod+r mode "resize"
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # ditto, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym Control+f mode "default"
}

# --------------
#  Control Mode
# --------------

set $control_pane alacritty --class control_pane
for_window [app_id="^control_pane$"] floating enable, border pixel $border_width

bindsym $mod+c exec $control_pane; mode "control"
mode "control" {
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym Control+f mode "default"
}

# =================
#  Special windows
# =================
for_window [app_id="eww"] border none

for_window [window_role="pop-up"]      floating enable, border pixel $border_width
for_window [window_role="bubble"]      floating enable, border pixel $border_width
for_window [window_role="task_dialog"] floating enable, border pixel $border_width
for_window [window_role="Preferences"] floating enable, border pixel $border_width

for_window [window_type="dialog"] floating enable, border pixel $border_width
for_window [window_type="menu"]   floating enable, border pixel $border_width

for_window [instance="__scratchpad"] floating enable, border pixel $border_width

for_window [class="(?i)pavucontrol"] floating enable, move position mouse, border pixel $border_width
for_window [class="(?i)pavucontrol" instance="pavucontrol-bar"] move down 34px

for_window [class="^firefox$" title="Options"] floating enable, border pixel $border_width

for_window [app_id="floating_term"] floating enable, border pixel $border_width
for_window [app_id="foot-sys-update"] floating enable, border pixel $border_width, resize set 40 ppt 40 ppt, move absolute position 0 0, move position 60 ppt 0, move left 3 px, move down 3 px
for_window [app_id="foot-calendar"] floating enable, border pixel $border_width, resize set 472 180, move position 100 ppt 0, move left 475 px, move down 3 px

for_window [title="Picture-in-Picture"] floating enable, border pixel $border_width

# Special application workspaces
assign [app_id="^firefox$"] workspace $wsff
assign [app_id="^zen-alpha$"] workspace $wszn
assign [class="^Spotify$"]  workspace $wssp
assign [class="^steam$"]    workspace $wsst
assign [class="^discord$"]  workspace $wsds
assign [class="^obsidian$"] workspace $wsob
assign [app_id="^anki$"]    workspace $wsan

# For gamedev
for_window [title="SUBSYMMETRY"] floating enable, border pixel $border_width
for_window [title="VOIDWALKERS"] floating enable, border pixel $border_width
for_window [title="METASEED"]    floating enable, border pixel $border_width
for_window [title="SPONZA"]      floating enable, border pixel $border_width

