}

output DP-4 {
    #background ~/Pictures/Backgrounds/abstract_squares.jpg fill
}

output DP-5 {
    #background ~/Pictures/Backgrounds/abstract_desert.jpg fill
}

# =====================
#  Input configuration
# =====================

input type:keyboard {
    xkb_options ctrl:nocaps
}

input type:touchpad {
    accel_profile       adaptive
    drag                enabled
    dwt                 enabled
    middle_emulation    enabled
    natural_scroll      enabled
    pointer_accel       0.25
    scroll_factor       0.5
    tap                 enabled
    tap_button_map      lmr
}

input "1267:13104:VEN_04F3:00_04F3:3330_Touchpad" {
    accel_profile adaptive
    pointer_accel 0
    natural_scroll enabled
    tap disabled
    #tap_and_drag enabled
    dwt enabled  # disable while typing
    scroll_method two_finger
    click_method clickfinger
}

